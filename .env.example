# Khoá API Anthropic cho phần luận giải AI; dataset không cần khóa.
ANTHROPIC_API_KEY=
# dataset: luận theo kho tiếng Việt đúng lá số; anthropic: dịch vụ tạo nội dung; demo: chỉ thử riêng.
READING_ENGINE=dataset
# Tặng 1 lượt duy nhất sau khi xác minh email, kể cả khi mở bán. Đặt 0 để tắt; tối đa 1.
FREE_READING_CREDITS=1
# Để 0 khi ra mắt trải nghiệm, chưa nhận tiền.
PAYMENTS_ENABLED=0
# Chỉ bật khi app nghe localhost và nginx của mình đặt X-Real-IP từ $remote_addr.
TRUST_PROXY=0
# Model phải thuộc các model tài khoản Anthropic của bạn có quyền dùng.
TUVI_MODEL=claude-sonnet-5-5
# Mặc định API chính thức. Chỉ đổi khi chủ động dùng endpoint khác.
TUVI_ANTHROPIC_BASE_URL=https://api.anthropic.com
SITE_URL=http://localhost:3100
# Chỉ giá trị content của thẻ google-site-verification, không dán cả thẻ HTML.
# Dùng khi xác minh URL-prefix trong Search Console; xác minh Domain dùng bản ghi DNS TXT.
GOOGLE_SITE_VERIFICATION=
# Đo hành trình bằng cookie phiên 30 phút, chỉ lưu sự kiện và nguồn tổng quát trong SQLite.
# Đặt 0 để tắt; trình duyệt bật DNT/GPC cũng không gửi sự kiện.
FUNNEL_ANALYTICS_ENABLED=1
# Thư mục dữ liệu đã dịch tiếng Việt (924 tháng, 1950–2026).
# Kho mới chỉ dùng sau pack + verify; có thể trỏ data/v4-vi để dùng kho tháng cũ.
TUVI_DATASET_DIR=data/v5-indexed
# SQLite trên ổ đĩa bền vững; không đặt trong thư mục public.
TUVI_DB_PATH=storage/tuvi.sqlite
# Mật khẩu quản trị tối thiểu 12 ký tự, dùng riêng cho site.
ADMIN_PASSWORD=
# Tùy chọn nâng cao: để trống để ẩn xác thực 2 lớp, đăng nhập bằng mật khẩu.
# Khi đã đặt secret Base32, hệ thống vẫn yêu cầu mã xác thực.
# Tạo tệp đăng ký riêng bằng node scripts/setup-admin-mfa.mjs, không commit secret.
ADMIN_TOTP_SECRET=
# Tùy chọn nâng cao: để trống để sao lưu SQLite cục bộ, quyền file 600.
# Nếu đã cấu hình public key RSA >=3072 bit thì backup vẫn được mã hóa.
TUVI_BACKUP_PUBLIC_KEY_FILE=
PAYMENT_PROVIDER=payos
# API chính thức được dùng mặc định. TUVI_PAYOS_BASE_URL chỉ dành cho endpoint chủ động cấu hình khi kiểm thử.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Chỉ thử local: mock + TUVI_ALLOW_TEST_PAYMENTS=1 và không có khóa Anthropic.
TUVI_ALLOW_TEST_PAYMENTS=0
# Gmail gửi thư xác minh, khôi phục mật khẩu và bài luận. Dùng Mật khẩu ứng dụng Google.
MAIL_PROVIDER=gmail
SMTP_USER=xemtuvionlinevn@gmail.com
SMTP_PASSWORD=
MAIL_FROM="Xem Tử Vi Online <xemtuvionlinevn@gmail.com>"
SUPPORT_EMAIL=xemtuvionlinevn@gmail.com
# Tuỳ chọn cũ: MAIL_PROVIDER=resend cần MAIL_FROM thuộc tên miền đã xác minh trên Resend.
RESEND_API_KEY=
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_TAX_ID=
# Đơn giá VND/triệu token để ước tính chi phí, lấy từ hóa đơn/gói API thực tế.
AI_INPUT_VND_PER_MILLION=
AI_OUTPUT_VND_PER_MILLION=
